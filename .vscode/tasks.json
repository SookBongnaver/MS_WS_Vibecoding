{
  "version": "2.0.0",
  "tasks": [
    {"label": "Workshop: offline tests", "type": "process", "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe", "args": ["-m", "unittest", "discover", "-s", "tests", "-v"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workshop: local check", "type": "process", "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe", "args": ["-m", "workshop", "check", "--local"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workshop: starter agent", "type": "process", "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe", "args": ["-m", "workshop", "run", "--scenario", "${input:scenario}", "--mode", "starter"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ],
  "inputs": [
    {"id": "scenario", "type": "pickString", "description": "Synthetic business scenario", "options": ["walkerhill", "mintit", "speedmate", "incross", "intellix"], "default": "walkerhill"}
  ]
}
